# ==============================================================================
# APPLICATION
# ==============================================================================
# The name of the AI Engine application
APP_NAME="Ascendra AI Engine"
# The port the FastAPI server will listen on
PORT=8000
# The environment the application is running in (development, staging, production)
ENVIRONMENT="development"

# ==============================================================================
# GOOGLE GEMINI
# ==============================================================================
# API key for accessing Google Gemini models
GEMINI_API_KEY="your-gemini-api-key"
# The specific Gemini model to use for generation
GEMINI_MODEL="gemini-1.5-pro"

# ==============================================================================
# LANGGRAPH
# ==============================================================================
# Enable or disable LangGraph debugging output (true/false)
LANGGRAPH_DEBUG="true"

# ==============================================================================
# DATABASE (Neon PostgreSQL)
# ==============================================================================
# The connection string for the PostgreSQL database (shared with backend)
DATABASE_URL="postgresql://user:password@hostname:5432/ascendra?sslmode=require"

# ==============================================================================
# REDIS
# ==============================================================================
# Redis connection URL for caching AI responses
REDIS_URL="redis://localhost:6379"

# ==============================================================================
# LOGGING
# ==============================================================================
# The minimum level of logs to record (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL="INFO"
