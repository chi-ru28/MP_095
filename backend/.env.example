# ==============================================================================
# APPLICATION
# ==============================================================================
# The environment the application is running in (development, test, production)
NODE_ENV=development
# The port the backend server will listen on
PORT=3000
# API Version prefix
API_VERSION=v1
# Global API route prefix
API_PREFIX=/api/v1

# ==============================================================================
# DATABASE (Neon PostgreSQL)
# ==============================================================================
# The connection string for the PostgreSQL database via Neon
DATABASE_URL="postgresql://user:password@hostname:5432/ascendra?sslmode=require"

# ==============================================================================
# REDIS
# ==============================================================================
# Redis connection URL for caching and rate limiting
REDIS_URL="redis://localhost:6379"

# ==============================================================================
# JWT AUTHENTICATION
# ==============================================================================
# Secret key used to sign Access Tokens
JWT_SECRET="your-super-secret-jwt-key"
# Secret key used to sign Refresh Tokens
JWT_REFRESH_SECRET="your-super-secret-refresh-key"
# Expiration time for Access Tokens (e.g., 15m, 1h)
JWT_ACCESS_EXPIRES="15m"
# Expiration time for Refresh Tokens (e.g., 7d, 30d)
JWT_REFRESH_EXPIRES="7d"

# ==============================================================================
# GOOGLE OAUTH
# ==============================================================================
# Google OAuth Client ID provided by Google Cloud Console
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
# Google OAuth Client Secret provided by Google Cloud Console
GOOGLE_CLIENT_SECRET="your-google-client-secret"
# The callback URL Google will redirect to after successful authentication
GOOGLE_CALLBACK_URL="http://localhost:3000/api/v1/auth/google/callback"

# ==============================================================================
# FRONTEND & AI ENGINE INTEGRATION
# ==============================================================================
# The URL of the React Frontend (used for CORS and redirects)
FRONTEND_URL="http://localhost:5173"
# The URL of the FastAPI AI Engine
AI_ENGINE_URL="http://localhost:8000"

# ==============================================================================
# LOGGING & SWAGGER
# ==============================================================================
# The minimum level of logs to record (debug, info, warn, error)
LOG_LEVEL="info"
# Whether to enable the Swagger UI documentation (true/false)
SWAGGER_ENABLED="true"

# ==============================================================================
# SECURITY
# ==============================================================================
# Secret used for signing cookies
COOKIE_SECRET="your-cookie-secret"
# Set to true to enforce HTTPS only cookies (should be true in production)
COOKIE_SECURE="false"
# SameSite cookie policy (Lax, Strict, None)
COOKIE_SAME_SITE="Lax"

# ==============================================================================
# RATE LIMITING
# ==============================================================================
# Time window in milliseconds (e.g., 60000 for 1 minute)
RATE_LIMIT_WINDOW="60000"
# Maximum number of requests allowed per window per IP
RATE_LIMIT_MAX="100"
